# Copy to .env.local for local dev. In production set these in Netlify > Site settings > Environment variables.
# Never commit real values.

MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/gizmorex
NEXT_PUBLIC_APP_URL=https://www.gizmorexweb.lk
NEXT_PUBLIC_APP_NAME=Gizmorex

# 32+ random characters, e.g. `openssl rand -hex 32`
JWT_SECRET=
NEXTAUTH_SECRET=

# Admin login (/admin-login). Make the hash with:
#   node -e "console.log(require('bcryptjs').hashSync('YOUR_PASSWORD', 12))"
# In .env.local write every $ in the hash as \$ (Next.js expands $ in env files). Netlify needs no escaping.
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# DirectPay IPG (from your DirectPay merchant portal)
DIRECTPAY_MERCHANT_ID=
DIRECTPAY_SECRET_KEY=
# DEV for sandbox testing, PROD for live payments
DIRECTPAY_STAGE=DEV
